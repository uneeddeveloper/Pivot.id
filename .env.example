# ─────────────────────────────────────────────────────────────────────────────
# Pivot — konfigurasi lingkungan
#
# Salin file ini jadi `.env` lalu isi nilainya:
#   cp .env.example .env
#
# `.env` sudah masuk .gitignore — jangan pernah commit token asli ke repo.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database (Prisma) ────────────────────────────────────────────────────────
# Format MySQL lokal:
#   DATABASE_URL="mysql://root:password@127.0.0.1:3306/rintisulang"
#
# Format TiDB Cloud (salin dari konsol TiDB → Connect → Prisma):
#   DATABASE_URL="mysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/dbname?sslaccept=strict"
#
# Setelah mengubah DATABASE_URL, jalankan: npm run db:push (dev) atau npm run db:migrate (prod)
DATABASE_URL="mysql://root:@127.0.0.1:3306/rintisulang"


# ── Sumopod (LLM) ────────────────────────────────────────────────────────────
# Sumopod menyediakan endpoint yang kompatibel dengan format OpenAI.
# Ambil kunci di dashboard Sumopod → AI → API Keys → Create key.
SUMOPOD_API_KEY=

# Base URL endpoint. Jangan sertakan `/chat/completions` — itu ditambahkan kode.
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1

# Nama model. Sesuaikan dengan katalog yang aktif di akunmu.
# Model murah dipakai untuk tugas volume tinggi (normalisasi lowongan, baca CV).
SUMOPOD_MODEL=gpt-4o-mini
# Model yang lebih pintar untuk tugas panjang (roadmap belajar, CV ATS).
# Boleh dikosongkan — kalau kosong, SUMOPOD_MODEL yang dipakai.
SUMOPOD_MODEL_SMART=

# Batas waktu satu panggilan LLM (milidetik).
SUMOPOD_TIMEOUT_MS=60000


# ── SerpApi (pencarian lowongan lewat Google Jobs) ───────────────────────────
# Sumber lowongan: engine `google_jobs` milik SerpApi — hasilnya adalah data
# lowongan terstruktur langsung dari Google Jobs, bukan hasil scraping sendiri.
# Daftar gratis 250 pencarian/bulan di https://serpapi.com
SERPAPI_KEY=

# Lokasi bawaan pencarian dan bahasa hasil.
JOB_SEARCH_LOCATION=Indonesia
JOB_SEARCH_HL=id
JOB_SEARCH_GL=id

# Berapa jam hasil pencarian dianggap masih segar sebelum SerpApi dipanggil
# lagi. Menaikkan angka ini menghemat kuota.
JOB_CACHE_TTL_HOURS=6

# Berapa hari jawaban LLM disimpan di tabel `llm_cache`.
LLM_CACHE_TTL_DAYS=14


# ── Otentikasi (Google OAuth & Auth.js) ──────────────────────────────────────
# Origin publik aplikasi — TANPA trailing slash, TANPA `/api/auth`.
#   Lokal      : http://localhost:3000
#   Production : https://<domain-vercel>.vercel.app
#
# WAJIB diisi di Vercel. Kalau kosong, Nitro plugin `assertOrigin` milik
# nuxt-auth melempar error saat server start dan SELURUH halaman balas
# 500 FUNCTION_INVOCATION_FAILED — bukan cuma halaman login.
AUTH_ORIGIN=http://localhost:3000

# String acak untuk menandatangani cookie sesi. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Pakai nilai BERBEDA antara lokal dan production.
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Authorized redirect URI yang harus didaftarkan di sana:
#   http://localhost:3000/api/auth/callback/google
#   https://<domain-vercel>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
